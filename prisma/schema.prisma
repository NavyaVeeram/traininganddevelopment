generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlserver"
  url      = env("DATABASE_URL")
}

/// The underlying table does not contain a valid unique identifier and can therefore currently not be handled by Prisma Client.
model Emp_Att_Program_Wise {
  Att_Id      Int       @id(map: "PK_Emp_Att_Program_Wise") @default(autoincrement())
  Program_Id  Int
  EmployeeId  String?   @db.VarChar(50)
  Username    String?   @db.VarChar(50)
  Department  String?   @db.VarChar(50)
  CreatedDate DateTime? @default(now(), map: "DF_Emp_Att_Program_Wise_CreatedDate") @db.DateTime
  CreatedBy   String?   @db.VarChar(50)

  @@ignore
}

model Standard_Program_Master {
  Std_Id        Int       @id(map: "PK_Standard_Program_Master") @default(autoincrement())
  Training_Name String?   @db.VarChar(50)
  Training_Code String?   @db.VarChar(50)
  Program_Name  String?   @db.VarChar(Max)
  CreatedDate   DateTime? @default(now(), map: "DF_Standard_Program_Master_CreatedDate") @db.DateTime
  CreatedBy     String?   @db.VarChar(50)
  UpdatedDate   DateTime? @db.DateTime
  UpdatedBy     String?   @db.VarChar(50)
}

model Training_Name_Master {
  Train_Id      Int       @id(map: "PK_Training_Name_Master") @default(autoincrement())
  Training_Name String?   @db.VarChar(50)
  Training_Code String?   @db.VarChar(50)
  CreatyedDate  DateTime? @default(now(), map: "DF_Training_Name_Master_CreatyedDate") @db.DateTime
  CreatedBy     String?   @db.VarChar(50)
  UpdatedDate   DateTime? @db.DateTime
  UpdatedBy     String?   @db.VarChar(50)
}

model TrainingData_Master {
  Program_Id        Int       @id(map: "PK_TrainingData_Master") @default(autoincrement())
  Training_Name     String?   @db.VarChar(50)
  Training_Code     String?   @db.VarChar(50)
  Year_No           Int?
  Department        String?   @db.VarChar(50)
  Program_Name      String?   @db.VarChar(Max)
  Train_Mode        String?   @db.VarChar(50)
  Train_Purpose     String?   @db.VarChar(Max)
  Persons           String?   @db.VarChar(50)
  No_Hrs            Int?
  No_Times          Int?
  Req_Months        String?   @db.VarChar(50)
  Evaluation_Period Int?
  Training_Date     DateTime? @db.Date
  Schedule_Type     String?   @db.VarChar(50)
  Trainer           String?   @db.VarChar(50)
  Venue             String?   @db.VarChar(50)
  Training_Budget   Float?
  CreatedDate       DateTime? @default(now(), map: "DF_HSE_Training_CreatedDate") @db.DateTime
  CreatedBy         String?   @db.VarChar(50)
  UpdatedDate       DateTime? @db.DateTime
  UpdatedBy         String?   @db.VarChar(50)
}

model UserMaster_HR {
  User_Id      Int       @id(map: "PK_UserMaster_HR") @default(autoincrement())
  EmployeeId   String?   @db.VarChar(10)
  Username     String    @db.VarChar(200)
  Password     String    @db.NVarChar(500)
  Department   String?   @db.VarChar(50)
  Section      String?   @db.VarChar(50)
  Designation  String?   @db.VarChar(50)
  Gender       String?   @db.VarChar(50)
  DOJ          DateTime? @db.Date
  CreatedDate  DateTime? @default(now(), map: "DF_UserMaster_HR_CreatedDate") @db.DateTime
  ModifiedDate DateTime? @db.DateTime
  IsActive     Int?
}

model Qualified_Trainer_List {
  Qual_Id       Int       @id(map: "PK_Qualified_Trainer_List") @default(autoincrement())
  Training_Name String?   @db.VarChar(50)
  EmployeeId    String?   @db.VarChar(50)
  Certified     Boolean?
  Exp_5_Yr      Boolean?
  Exp_3_Yr      Boolean?
  HOD_Rec       Boolean?
  Qualified     Boolean?
  CreatedDate   DateTime? @default(now(), map: "DF_Qualified_Trainer_List_CreatedDate") @db.DateTime
  CreatedBy     String?   @db.VarChar(50)
}
